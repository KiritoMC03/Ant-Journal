{
  "name": "ant-journal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE",
  "packageManager": "npm@12.2.1",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build && node --import tsx scripts/check-build.ts",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs sync && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "astro": "7.4.2",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-gfm": "4.0.1",
    "remark-rehype": "11.1.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
