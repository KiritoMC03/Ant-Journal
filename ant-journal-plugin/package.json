{
  "name": "ant-journal-core",
  "version": "1.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "init:vault": "node scripts/init-vault.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "install:plugin": "node scripts/install.mjs",
    "setup:community": "node scripts/community.mjs",
    "setup:metadata": "node scripts/metadata-menu.mjs",
    "template:render": "node scripts/render-template.mjs",
    "archive:render": "node --import tsx scripts/render-archive.ts",
    "check:public": "node scripts/public-check.mjs",
    "safety:install-hooks": "node scripts/install-safety-hooks.mjs",
    "smoke:prepare": "node scripts/smoke.mjs",
    "validate": "node --import tsx scripts/validate.ts"
  },
  "dependencies": { "yaml": "2.9.1" },
  "devDependencies": {
    "@types/node": "22.18.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
