---
import {getCollection} from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import Feeding from '../components/Feeding.astro';
import EntryCard from '../components/EntryCard.astro';
import {readSnapshot} from '../lib/snapshot';
import type {Page} from '../lib/types';
import {url} from '../lib/config';
import {dateLabel,calendarHtml,monthLabel} from '../lib/visuals';
import {display} from '../../../ant-journal-plugin/src/model';
export async function getStaticPaths(){const pages=await getCollection('vault');return pages.map(p=>({params:{path:(p.data as unknown as Page).route.replace(/\/$/,'')||undefined},props:{page:p.data}}));}
const {page}=Astro.props as {page:Page},snapshot=await readSnapshot();
const colony=snapshot.colonies.find(c=>c.id===page.colonyId);
const entry=snapshot.entries.find(e=>e.route===page.route);
const hero=snapshot.entries.flatMap(e=>e.media).find(m=>m.kind==='image');
const calendarEntries=snapshot.entries.map(e=>({date:e.date,colonyId:e.colonyId,href:url(e.route),name:snapshot.colonies.find(c=>c.id===e.colonyId)!.name}));
const months=[...new Set(snapshot.entries.map(e=>e.date.slice(0,7)))].sort().reverse();
const countLabels=[['workers','Workers'],['queens','Queens'],['eggs','Eggs'],['larvae','Larvae'],['pupae','Pupae'],['worker_deaths','Interval deaths'],['temperature_c','Temperature · °C'],['humidity_pct','Humidity · %']];
const notes=colony?.entries??[];
const gallery=notes.flatMap(note=>note.media.map(asset=>({asset,note}))).filter((item,index,all)=>all.findIndex(other=>other.asset.source===item.asset.source)===index);
const position=entry?notes.findIndex(e=>e.path===entry.path):-1;
---
<Layout {snapshot} {page}>
{page.kind==='home'&&<>
  <section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"/> OBSERVE · RECORD · UNDERSTAND</p><h1>A closer look<br/>at a <em>smaller</em><br/>world.</h1><p class="hero-description">The everyday lives of ant colonies,<br/>one careful observation at a time.</p><a class="button" href={url('archive/')}>Explore the journal <span>↗</span></a><div class="hero-counts"><span><strong>{snapshot.colonies.length}</strong> colonies</span><span><strong>{snapshot.entries.length}</strong> observations</span><span><strong>{snapshot.media.length}</strong> original media</span></div></div><div class="hero-photo">{hero&&<img src={hero.src} srcset={hero.srcset} sizes="(max-width: 760px) 100vw, 55vw" width={hero.width} height={hero.height} alt="Photograph from the observation archive" fetchpriority="high"/>}<div class="hero-caption"><span>FROM THE FIELD NOTES</span><p>{snapshot.entries.find(e=>e.media.includes(hero!))?.date??snapshot.entries[0]?.date} · Original colony photograph</p></div><span class="vertical-label">LIFE, ON A DIFFERENT SCALE</span></div></section>
  <section class="section colonies-section"><div class="section-title"><div><p class="eyebrow">THE INHABITANTS</p><h2>Meet the colonies.</h2></div><a class="text-link" href={url('compare/')}>Compare colonies ↗</a></div><div class="colony-grid">{snapshot.colonies.map((c,i)=><a class="colony-card" href={url(c.route)}><span class="colony-number">0{i+1} / {c.id}</span><h3>{c.name}</h3><p class="species">{c.species}</p><div class="colony-card-bottom"><span>{c.latest.workers?`${display(c.latest.workers.value)} workers`:'Workers unknown'}<small>{c.latest.workers?dateLabel(c.latest.workers.date):'No measurement yet'}</small></span><span class="round-arrow">↗</span></div></a>)}</div></section>
  <section class="section"><div class="section-title"><div><p class="eyebrow">RECENT FIELD NOTES</p><h2>Life, as it happens.</h2></div><a class="text-link" href={url('archive/')}>All observations ↗</a></div><div class="entry-grid">{snapshot.entries.slice(0,6).map(e=><EntryCard entry={e} colony={snapshot.colonies.find(c=>c.id===e.colonyId)!}/>)}</div>{!snapshot.entries.length&&<p class="empty-state">The first observations will appear here as soon as they are recorded.</p>}</section>
  <section class="journal-statement"><p class="eyebrow">A NOTE ON THE NOTES</p><p>Every entry is a moment observed.<br/>Every estimate keeps its uncertainty.<br/><em>The gaps are part of the story, too.</em></p><a class="text-link" href={url('guide/dataschema/')}>How to read the measurements ↗</a></section>
</>}
{page.kind==='archive'&&<section class="section archive-section"><p class="eyebrow">THE FIELD NOTES</p><h1>The observation<br/><em>archive.</em></h1><p class="intro">An ongoing record of colony life. Follow a colony, choose a date, or find a detail.</p><div class="archive-controls controls"><label class="search-label">Search observations<input type="search" data-search-input placeholder="A colony, feeding, a small discovery…"/></label><label>Colony<select data-colony-filter><option value="">All colonies</option>{snapshot.colonies.map(c=><option value={c.id}>{c.name} · {c.id}</option>)}</select></label><label>From<input type="date" data-archive-from/></label><label>To<input type="date" data-archive-to/></label><button class="reset-button" data-reset>Reset</button></div><p class="results-count" data-results aria-live="polite">{snapshot.entries.length} observations</p><div class="entry-grid" data-archive-list>{snapshot.entries.map(e=><EntryCard entry={e} colony={snapshot.colonies.find(c=>c.id===e.colonyId)!}/>)}</div><p class="empty-state" data-no-results hidden>No observations match these filters.</p><div class="pagination" data-pagination hidden><button data-prev-page>← Previous</button><span data-page-label/><button data-next-page>Next →</button></div></section>}
{page.kind==='calendar'&&<section class="section"><p class="eyebrow">THE RHYTHM OF THE JOURNAL</p><h1>A calendar of<br/><em>small discoveries.</em></h1><p class="intro">Each link is a real observation. Several colonies can share a day; unrecorded days remain open.</p><div class="controls calendar-controls"><label>Colony<select data-calendar-colony><option value="">All colonies</option>{snapshot.colonies.map(c=><option value={c.id}>{c.name}</option>)}</select></label><div data-calendar-navigation hidden><button data-prev-month aria-label="Previous month">←</button><label>Month<input type="month" data-month value={months[0]}/></label><button data-next-month aria-label="Next month">→</button></div></div><div data-calendars>{months.map(month=><section class="calendar-panel"><h2>{monthLabel(month)}</h2><Fragment set:html={calendarHtml(month,calendarEntries)}/></section>)}</div>{!months.length&&<p class="empty-state">No observations have been recorded yet.</p>}<script type="application/json" data-calendar-data set:html={JSON.stringify(calendarEntries).replaceAll('<','\u003c')}/></section>}
{page.kind==='compare'&&<section class="section"><p class="eyebrow">THE INHABITANTS</p><h1>Across the<br/><em>colonies.</em></h1><p class="intro">The latest known measurements, each with its own observation date. Estimates retain their ~ marker.</p><div class="colony-grid">{snapshot.colonies.map(c=><article class="compare-card"><p class="eyebrow">{c.id}</p><h2><a href={url(c.route)}>{c.name} ↗</a></h2><p class="species">{c.species}</p><dl>{countLabels.slice(0,5).map(([key,label])=><div><dt>{label}</dt><dd>{c.latest[key]?display(c.latest[key].value):'?'}<small>{c.latest[key]?c.latest[key].date:'No known value'}</small></dd></div>)}</dl><a class="button" href={url(c.route)}>Open colony journal ↗</a></article>)}</div></section>}
{page.kind==='colony'&&colony&&<>
  <section class="section colony-heading"><a class="breadcrumb" href={url('compare/')}>← All colonies</a><div class="colony-intro"><div><p class="eyebrow">COLONY {colony.id}</p><h1>{colony.name}</h1><p class="latin-title">{colony.species}</p><p class="intro">{colony.entries.length} dated observations. {colony.entries.at(-1)?.date&&`Following this colony since ${dateLabel(colony.entries.at(-1)!.date)}.`}</p></div>{colony.cover&&<img class="colony-portrait" src={colony.cover.src} width={colony.cover.width} height={colony.cover.height} alt={colony.species}/>}</div><div class="metric-grid">{countLabels.slice(0,5).map(([key,label])=><div class="metric"><span>{label}</span><strong>{colony.latest[key]?display(colony.latest[key].value):'?'}</strong><small>{colony.latest[key]?.date??'Not observed'}</small></div>)}</div><details class="colony-facts"><summary>Colony background and keeper notes</summary><dl class="facts">{Object.entries(colony.data).filter(([key,value])=>value!==null&&value!==''&&!key.startsWith('_metric')).map(([key,value])=><div><dt>{key.replaceAll('_',' ')}</dt><dd>{String(value)}</dd></div>)}</dl><div class="prose" set:html={colony.html}/></details></section>
  <section class="section chart-section"><Chart {colony}/><Feeding {colony}/></section>
  {gallery.length>0&&<section class="section"><div class="section-title"><div><p class="eyebrow">A WINDOW INTO THE COLONY</p><h2>From the photographs.</h2></div><span class="small-note">{gallery.length} original images and videos</span></div><div class="gallery-grid">{gallery.map(({asset,note})=><figure><a class="gallery-thumb" href={asset.kind==='image'?asset.src:url(note.route)} data-gallery={asset.kind==='image'?'true':undefined}>{asset.kind==='image'?<img src={asset.src} width={asset.width} height={asset.height} loading="lazy" alt={asset.source.split('/').at(-1)}/>:asset.poster?<><img src={asset.poster} loading="lazy" alt={`Video from ${note.date}`}/><span class="video-badge">▶ VIDEO</span></>:<span class="no-image">Original file ↗</span>}</a><figcaption><a href={url(note.route)}>{dateLabel(note.date)}</a><a href={asset.original} download>Original ↗</a></figcaption></figure>)}</div></section>}
  <section class="section"><div class="section-title"><div><p class="eyebrow">THE COLONY TIMELINE</p><h2>From the journal.</h2></div><a class="text-link" href={url(`archive/?colony=${colony.id}`)}>Filter the archive ↗</a></div><div class="entry-grid">{colony.entries.map(e=><EntryCard entry={e} {colony}/>)}</div></section>
</>}
{page.kind==='entry'&&entry&&colony&&<article class="observation section"><nav class="breadcrumb" aria-label="Breadcrumb"><a href={url('archive/')}>Journal</a><span>/</span><a href={url(colony.route)}>{colony.name}</a><span>/</span><time>{entry.date}</time></nav><header class="observation-heading"><p class="eyebrow">FIELD NOTE · {colony.id}</p><h1>{dateLabel(entry.date)}</h1><p class="latin-title">{colony.species} <span class={`condition ${entry.data.condition}`}>{String(entry.data.condition)}</span></p></header><div class="metric-grid observation-metrics">{countLabels.map(([key,label])=><div class="metric"><span>{label}</span><strong>{display(entry.values[key])}</strong></div>)}</div><div class="feeding-flags">{[['feed_syrup','Syrup'],['feed_protein','Protein'],['feed_seeds','Seeds'],['watered','Water added']].map(([key,label])=><span class={entry.data[key]===true?'recorded':''}>{entry.data[key]===true?'✓':'—'} {label}</span>)}</div>{['feed_notes','water_notes','notes'].map(key=>entry.data[key]&&<aside class="note-aside"><strong>{key.replaceAll('_',' ')}</strong><p>{String(entry.data[key])}</p></aside>)}<div class="prose" set:html={entry.html}/><nav class="entry-navigation" aria-label="Adjacent observations">{notes[position+1]?<a href={url(notes[position+1].route)}><small>PREVIOUS OBSERVATION</small>← {dateLabel(notes[position+1].date)}</a>:<span/>}{notes[position-1]?<a href={url(notes[position-1].route)}><small>NEXT OBSERVATION</small>{dateLabel(notes[position-1].date)} →</a>:<span/>}</nav></article>}
{['page','guide','legal'].includes(page.kind)&&<section class="section reading-page"><p class="eyebrow">{page.kind==='guide'?'THE JOURNAL GUIDE':page.kind==='legal'?'LICENSE & NOTICES':'FROM THE NOTEBOOK'}</p><h1>{page.title}</h1><div class="reading-layout"><article class="prose" set:html={page.html}/>{page.kind==='guide'&&<aside class="guide-nav"><p class="eyebrow">IN THE GUIDE</p>{snapshot.pages.filter(p=>p.kind==='guide').map(p=><a href={url(p.route)} aria-current={p.route===page.route?'page':undefined}>{p.title}</a>)}</aside>}</div></section>}
</Layout>
