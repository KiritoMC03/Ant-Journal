  "enableEditor": true,
  "enableMarkdown": true,
  "enableLinks": true,
  "firstDayOfWeek": 1,
  "chooseFileClassAtFileCreation": false,
  "autoInsertFieldsAtFileClassInsertion": false,
  "showFileClassSelectInModal": false,
  "isAutoCalculationEnabled": false,
  "disableDataviewPrompt": true
